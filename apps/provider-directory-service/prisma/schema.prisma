generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("PROVIDER_DATABASE_URL")
}

model Specialty {
  id                String                 @id @default(cuid())
  name              String                 @unique @db.VarChar(120)
  slug              String                 @unique @db.VarChar(140)
  description       String?
  isActive          Boolean                @default(true) @map("is_active")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  iconUrl           String?                @map("icon_url") @db.VarChar(255)
  aliases           String[]
  commonSymptoms    String[]               @map("common_symptoms")
  commonConditions  String[]               @map("common_conditions")
  keywords          String[]
  expertise         String[]
  doctorSpecialties DoctorSpecialty[]
  infoSections      SpecialtyInfoSection[]

  @@map("specialties")
}

model SpecialtyInfoSection {
  id          String    @id @default(cuid())
  specialtyId String    @map("specialty_id") @db.VarChar(27)
  name        String    @db.VarChar(120)
  content     String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@index([specialtyId], map: "idx_specialty_info_sections_specialty")
  @@map("specialty_info_sections")
}

model WorkLocation {
  id                  String               @id @default(cuid())
  name                String               @db.VarChar(160)
  address             String?              @db.VarChar(255)
  phone               String?              @db.VarChar(32)
  timezone            String               @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  googleMapUrl        String?              @map("google_map_url") @db.VarChar(500)
  doctorWorkLocations DoctorWorkLocation[]
  officeHours         OfficeHours[]
  schedules           Schedule[]
  specialShifts       SpecialShift[]

  @@index([name], map: "idx_work_locations_name")
  @@map("work_locations")
}

model Doctor {
  id                  String               @id @default(cuid())
  staffAccountId      String               @unique @map("staff_account_id")
  isActive            Boolean              @default(true) @map("is_active")
  degree              String?              @db.VarChar(100)
  position            String[]
  introduction        String?
  education           String[]
  experience          String[]
  avatarUrl           String?              @map("avatar_url") @db.VarChar
  portrait            String?              @db.VarChar
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  appointmentDuration Int                  @default(30) @map("appointment_duration")
  fullName            String               @default("") @map("full_name") @db.VarChar(100)
  isMale              Boolean?             @default(true) @map("is_male")
  ratings             Float?
  serviceCost         Int?                 @map("service_cost")
  experienceYears     Int?                 @map("experience_years")
  conditions          String[]
  symptoms            String[]
  expertise           String[]
  procedures          String[]
  patientGroups       String[]               @map("patient_groups")
  specialtyIds        String[]               @map("specialty_ids")
  doctorSpecialties   DoctorSpecialty[]
  doctorWorkLocations DoctorWorkLocation[]
  officeHours         OfficeHours[]
  schedules           Schedule[]
  specialShifts       SpecialShift[]

  @@map("doctors")
}

model DoctorSpecialty {
  id          String    @id @default(cuid())
  doctorId    String    @map("doctor_id") @db.VarChar(27)
  specialtyId String    @map("specialty_id") @db.VarChar(27)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  doctor      Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([doctorId, specialtyId])
  @@index([specialtyId], map: "idx_doctor_specialties_specialty")
  @@map("doctor_specialties")
}

model DoctorWorkLocation {
  id         String       @id @default(cuid())
  doctorId   String       @map("doctor_id") @db.VarChar(27)
  locationId String       @map("location_id") @db.VarChar(27)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  doctor     Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  location   WorkLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([doctorId, locationId])
  @@map("doctor_work_locations")
}

model Schedule {
  id          String       @id @default(cuid())
  doctorId    String       @map("doctor_id") @db.VarChar(27)
  locationId  String       @map("location_id") @db.VarChar(27)
  serviceDate DateTime     @map("service_date") @db.Date
  timeStart   DateTime     @map("time_start") @db.Time(6)
  timeEnd     DateTime     @map("time_end") @db.Time(6)
  capacity    Int          @default(1) @db.SmallInt
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  doctor      Doctor       @relation(fields: [doctorId], references: [id])
  location    WorkLocation @relation(fields: [locationId], references: [id])

  @@unique([doctorId, locationId, serviceDate, timeStart, timeEnd])
  @@index([serviceDate], map: "idx_schedules_service_date")
  @@index([doctorId, serviceDate], map: "idx_schedules_doctor_date")
  @@index([locationId, serviceDate], map: "idx_schedules_location_date")
  @@map("schedules")
}

model OfficeHours {
  id             String        @id @default(cuid())
  doctorId       String?       @map("doctor_id") @db.VarChar(27)
  workLocationId String?       @map("work_location_id") @db.VarChar(27)
  dayOfWeek      Int           @map("day_of_week") @db.SmallInt
  startTime      DateTime      @map("start_time") @db.Time(6)
  endTime        DateTime      @map("end_time") @db.Time(6)
  isGlobal       Boolean       @default(false) @map("is_global")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  doctor         Doctor?       @relation(fields: [doctorId], references: [id])
  workLocation   WorkLocation? @relation(fields: [workLocationId], references: [id])

  @@index([workLocationId, dayOfWeek], map: "idx_office_hours_location_day")
  @@index([doctorId, workLocationId, dayOfWeek], map: "idx_office_hours_doctor_location_day")
  @@map("office_hours")
}

// Async-replicated snapshot from booking-service via RabbitMQ events
// Used by slot engine to avoid cross-service HTTP calls at query time
model BookedSlot {
  id            String   @id @default(cuid())
  appointmentId String   @unique @map("appointment_id")
  doctorId      String   @map("doctor_id") @db.VarChar(27)
  slotDate      DateTime @map("slot_date") @db.Date
  timeStart     String   @map("time_start") @db.VarChar(5)
  // Tombstone flag: true means cancelled-event arrived before booked-event (EC-3)
  isCancelled   Boolean  @default(false) @map("is_cancelled")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([doctorId, slotDate], map: "idx_booked_slots_doctor_date")
  @@map("booked_slots")
}

// Doctor-level exceptions: days off, holidays, personal blocks
model DoctorException {
  id        String   @id @default(cuid())
  doctorId  String   @map("doctor_id") @db.VarChar(27)
  date      DateTime @db.Date
  startTime String?  @map("start_time") @db.VarChar(5)
  endTime   String?  @map("end_time") @db.VarChar(5)
  isFullDay Boolean  @default(false) @map("is_full_day")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([doctorId, date], map: "idx_doctor_exceptions_doctor_date")
  @@map("doctor_exceptions")
}

// Clinic-level exceptions: global holidays, system-wide closures
model ClinicException {
  id             String        @id @default(cuid())
  workLocationId String?       @map("work_location_id") @db.VarChar(27) // null = Global Holiday
  date           DateTime      @db.Date
  startTime      String?       @map("start_time") @db.VarChar(5)
  endTime        String?       @map("end_time") @db.VarChar(5)
  isFullDay      Boolean       @default(true) @map("is_full_day")
  reason         String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([workLocationId, date], map: "idx_clinic_exceptions_location_date")
  @@map("clinic_exceptions")
}

// Special Shifts (Overrides): On-call shifts, Emergency duties, Holiday shifts
model SpecialShift {
  id             String        @id @default(cuid())
  doctorId       String        @map("doctor_id") @db.VarChar(27)
  workLocationId String?       @map("work_location_id") @db.VarChar(27)
  date           DateTime      @db.Date
  startTime      DateTime      @map("start_time") @db.Time(6)
  endTime        DateTime      @map("end_time") @db.Time(6)
  reason         String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  doctor         Doctor        @relation(fields: [doctorId], references: [id])
  workLocation   WorkLocation? @relation(fields: [workLocationId], references: [id])

  @@index([doctorId, date], map: "idx_special_shifts_doctor_date")
  @@index([workLocationId, date], map: "idx_special_shifts_location_date")
  @@map("special_shifts")
}
